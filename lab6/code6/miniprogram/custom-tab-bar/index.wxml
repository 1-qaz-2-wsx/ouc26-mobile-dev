<cover-view class="tab-shell" wx:if="{{!hidden}}">
  <cover-view class="tab-item {{selected === index ? 'tab-item-selected' : ''}}" wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" bindtap="switchTab">
    <cover-view class="tab-line"></cover-view>
    <cover-view>{{item.text}}</cover-view>
  </cover-view>
</cover-view>
