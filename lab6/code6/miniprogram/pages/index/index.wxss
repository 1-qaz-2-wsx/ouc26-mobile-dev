.upload-fab {
  display: flex;
  height: 92rpx;
  align-items: center;
  padding: 0 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 46rpx 10rpx 46rpx 10rpx;
  background: #17211b;
  box-shadow: 0 18rpx 38rpx rgba(23, 33, 27, 0.28);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.upload-fab-active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.plus-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border: 2rpx solid #d4a94e;
  border-radius: 50%;
}

.plus-icon::before,
.plus-icon::after {
  position: absolute;
  top: 15rpx;
  left: 8rpx;
  width: 16rpx;
  height: 2rpx;
  background: #d4a94e;
  content: "";
}

.plus-icon::after {
  transform: rotate(90deg);
}

.loader {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 30rpx;
  border: 5rpx solid rgba(36, 107, 75, 0.16);
  border-top-color: #246b4b;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.index-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 8rpx 4rpx;
}

.index-head .page-title {
  display: block;
  margin: 6rpx 0 20rpx;
}

.message-entry { position: relative; width: 76rpx; height: 76rpx; border: 2rpx solid rgba(23,33,27,.14); border-radius: 50%; background:#fffdf8; }
.message-entry text { position:absolute; top:-8rpx; right:-8rpx; min-width:32rpx; height:32rpx; padding:0 7rpx; border-radius:16rpx; background:#e95a3f; color:#fff; font-size:18rpx; line-height:32rpx; text-align:center; }
.message-icon { position:absolute; top:21rpx; left:18rpx; width:36rpx; height:28rpx; border:3rpx solid #17211b; border-radius:6rpx; }
.message-icon::after { position:absolute; bottom:-9rpx; left:6rpx; width:10rpx; height:10rpx; border-left:3rpx solid #17211b; transform:skewY(-38deg); content:""; }
.discover-tools { margin: 0 0 16rpx; }
.search-box { display:flex; height:82rpx; align-items:center; padding:0 22rpx; border:2rpx solid rgba(23,33,27,.11); border-radius:24rpx 6rpx 24rpx 6rpx; background:#fffdf8; }
.search-box input { flex:1; margin-left:16rpx; font-size:26rpx; }
.search-box text { color:#246b4b; font-size:22rpx; }
.search-icon { width:25rpx; height:25rpx; border:3rpx solid #718078; border-radius:50%; position:relative; }
.search-icon::after { position:absolute; right:-9rpx; bottom:-6rpx; width:12rpx; height:3rpx; background:#718078; transform:rotate(45deg); content:""; }
.feed-tabs { display:flex; margin-top:22rpx; border-bottom:2rpx solid rgba(23,33,27,.1); }
.feed-tab { position:relative; padding:14rpx 32rpx 18rpx; color:#718078; font-size:28rpx; font-weight:600; }
.feed-tab.active { color:#17211b; }
.feed-tab.active::after { position:absolute; right:28rpx; bottom:-2rpx; left:28rpx; height:6rpx; background:#e95a3f; content:""; }
.social-row { display:flex; align-items:center; padding:14rpx 18rpx 2rpx; }
.social-action { display:flex; height:58rpx; align-items:center; margin:0 8rpx 0 0; padding:0 12rpx; background:transparent; color:#718078; font-size:22rpx; line-height:58rpx; }
.social-action.active { color:#e95a3f; }
.save-action { margin-left:auto; }
.heart-icon { position:relative; width:30rpx; height:27rpx; margin-right:9rpx; }
.heart-icon::before { content:'♡'; position:absolute; top:-16rpx; font-size:40rpx; }
.active .heart-icon::before { content:'♥'; }
.comment-icon { width:27rpx; height:22rpx; margin-right:10rpx; border:3rpx solid currentColor; border-radius:5rpx; }
.save-icon { width:22rpx; height:28rpx; margin-right:10rpx; border:3rpx solid currentColor; border-bottom:0; }
.compact-state { min-height:300rpx; }

.index-float {
  bottom: calc(132rpx + env(safe-area-inset-bottom));
}
