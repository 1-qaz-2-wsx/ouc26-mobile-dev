<!-- pages/index/index.wxml -->
<navigation-bar title="个人名片" back="{{false}}" color="#ffffff" background="#075985"></navigation-bar>

<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">

  <view class="page-shell">
    <view class="hero-heading">
      <text class="eyebrow">MY PROFILE</text>
      <text class="page-title">你好，我是马一诺</text>
      <text class="page-subtitle">用代码探索海洋，用技术连接世界</text>
    </view>
    <view class="profile-card">
      <image class="profile-image" src="/img/profile-card.jpg" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
      <view class="card-content">
        <view class="identity-row">
          <view>
            <text class="name">马一诺</text>
            <text class="identity">计算机科学与技术专业 · 本科生</text>
          </view>
          <text class="school-badge">OUC</text>
        </view> 
        <view class="divider"></view>
        <view class="intro-section">
          <text class="section-title">个人介绍</text>
          <text class="intro-text">我来自中国海洋大学信息科学与工程学部，主修计算机科学与技术。我热爱编程与人工智能，喜欢把灵感变成简洁、实用的作品，也期待用技术探索更广阔的海洋世界。</text>
        </view> 
        <view class="intro-section">
          <text class="section-title">兴趣方向</text>
          <view class="tag-list">
            <text class="tag">前端开发</text><text class="tag">人工智能</text>
            <text class="tag">移动应用</text><text class="tag">海洋信息</text>
          </view>
        </view>
        <view class="motto">
          <text class="quote-mark">“</text>
          <text class="motto-text">保持好奇，持续学习，让每一行代码都有意义。</text>
        </view>
      </view>
    </view>
    <text class="footer">OCEAN UNIVERSITY OF CHINA</text>
  </view>

</scroll-view> 
