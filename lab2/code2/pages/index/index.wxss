page {
  height: 100vh;
  background: #edf7fc;
  color: #0f2f46;
}
.page-scroll {
  height: calc(100vh - 88rpx);
  background: linear-gradient(180deg, #075985 0, #0e7490 280rpx, #edf7fc 620rpx);
}
.page-shell { padding: 48rpx 30rpx 52rpx; box-sizing: border-box; }
.hero-heading { display: flex; flex-direction: column; padding: 8rpx 12rpx 38rpx; color: #fff; }
.eyebrow { margin-bottom: 12rpx; color: #bae6fd; font-size: 20rpx; font-weight: 600; letter-spacing: 6rpx; }
.page-title { font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; }
.page-subtitle { margin-top: 12rpx; color: #e0f2fe; font-size: 26rpx; letter-spacing: 1rpx; }
.profile-card { overflow: hidden; border: 1rpx solid rgba(255,255,255,.75); border-radius: 28rpx; background: #fff; box-shadow: 0 20rpx 55rpx rgba(7,89,133,.18); }
.profile-image { display: block; width: 100%; background: #dbeafe; }
.card-content { padding: 36rpx 34rpx 38rpx; }
.identity-row { display: flex; align-items: center; justify-content: space-between; }
.name, .identity { display: block; }
.name { color: #0c4a6e; font-size: 40rpx; font-weight: 700; }
.identity { margin-top: 8rpx; color: #64748b; font-size: 24rpx; }
.school-badge { margin-left: 20rpx; padding: 10rpx 16rpx; border-radius: 12rpx; background: #075985; color: #fff; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.divider { height: 1rpx; margin: 30rpx 0; background: #dbeafe; }
.intro-section + .intro-section { margin-top: 30rpx; }
.section-title { display: block; position: relative; padding-left: 18rpx; color: #075985; font-size: 28rpx; font-weight: 700; }
.section-title::before { content: ''; position: absolute; left: 0; top: 7rpx; width: 6rpx; height: 26rpx; border-radius: 6rpx; background: #06b6d4; }
.intro-text { display: block; margin-top: 18rpx; color: #475569; font-size: 27rpx; line-height: 1.85; text-align: justify; }
.tag-list { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.tag { margin: 12rpx 12rpx 0 0; padding: 10rpx 20rpx; border: 1rpx solid #bae6fd; border-radius: 999rpx; background: #f0f9ff; color: #0369a1; font-size: 23rpx; }
.motto { display: flex; align-items: flex-start; margin-top: 34rpx; padding: 24rpx 26rpx; border-radius: 18rpx; background: linear-gradient(135deg,#ecfeff,#eff6ff); }
.quote-mark { margin-right: 10rpx; color: #0891b2; font-family: serif; font-size: 48rpx; line-height: 1; }
.motto-text { flex: 1; color: #155e75; font-size: 25rpx; line-height: 1.7; }
.footer { display: block; margin-top: 34rpx; color: #6090a8; font-size: 18rpx; letter-spacing: 4rpx; text-align: center; }
}
