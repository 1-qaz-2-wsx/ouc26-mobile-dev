page {
  min-height: 100%;
  background: #f3f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, image, button {
  box-sizing: border-box;
}

.news-list {
  padding: 0 28rpx 32rpx;
}

.news-item {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.news-item:last-child {
  border-bottom: 0;
}

.news-poster {
  flex: 0 0 220rpx;
  width: 220rpx;
  height: 150rpx;
  margin-right: 24rpx;
  border-radius: 14rpx;
  background: #dbeafe;
}

.news-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
}

.news-title {
  display: -webkit-box;
  overflow: hidden;
  color: #172033;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #8491a5;
  font-size: 22rpx;
}

.news-category {
  color: #006bb6;
}
