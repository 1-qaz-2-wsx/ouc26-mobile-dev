<view class="detail-page {{isDark ? 'theme-dark' : ''}} font-{{fontSize}}">
  <view wx:if="{{article}}" class="article-card">
    <view class="article-category">{{article.category}}</view>
    <view class="article-title">{{article.title}}</view>
    <view class="article-meta"><text>中国海洋大学新闻网</text><text>{{article.add_date}}</text></view>
    <image class="article-poster" src="{{article.poster}}" mode="widthFix"></image>
    <view class="article-summary">导语：{{article.summary}}</view>
    <text class="article-content">{{article.content}}</text>
    <view class="article-footer">— END —</view>
    <view class="related-title">相关推荐</view>
    <view class="related-item" wx:for="{{related}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image src="{{item.poster}}" mode="aspectFill"></image><view><text>{{item.title}}</text><text class="related-date">{{item.add_date}}</text></view>
    </view>
  </view>
  <view wx:elif="{{notFound}}" class="empty-state"><text class="empty-icon">📰</text><text>新闻不存在</text></view>

  <view wx:if="{{article}}" class="detail-toolbar">
    <view bindtap="toggleFavorite"><text class="tool-icon {{isFavorite ? 'heart-active' : ''}}">{{isFavorite ? '♥' : '♡'}}</text><text>{{isFavorite ? '已收藏' : '收藏'}}</text></view>
    <button open-type="share"><text class="tool-icon">↗</text><text>分享</text></button>
    <view bindtap="copyTitle"><text class="tool-icon">▣</text><text>复制标题</text></view>
    <view bindtap="changeFontSize"><text class="tool-icon">Aa</text><text>字号</text></view>
  </view>
</view>
