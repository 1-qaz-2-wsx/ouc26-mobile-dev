.detail-page{min-height:100vh;padding:24rpx 0 150rpx;background:#f3f7fb}.article-card{margin:0 24rpx;padding:38rpx 32rpx 46rpx;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(15,52,77,.08)}.article-category{display:inline-block;padding:8rpx 17rpx;border-radius:999rpx;background:#e6f4ff;color:#006bb6;font-size:22rpx}.article-title{margin-top:24rpx;color:#102f49;font-size:42rpx;font-weight:700;line-height:1.45}.article-meta{display:flex;justify-content:space-between;margin:20rpx 0 30rpx;color:#8491a5;font-size:22rpx}.article-poster{display:block;width:100%;border-radius:16rpx}.article-summary{margin:30rpx 0;padding:22rpx 24rpx;border-left:6rpx solid #0086b8;background:#f0f8fd;color:#42627a;font-size:25rpx;line-height:1.7}.article-content{display:block;white-space:pre-wrap;color:#334155;line-height:2;text-align:justify}.font-small .article-content{font-size:26rpx}.font-medium .article-content{font-size:29rpx}.font-large .article-content{font-size:34rpx}.article-footer{margin:36rpx 0;color:#a1adba;font-size:20rpx;letter-spacing:4rpx;text-align:center}.related-title{padding-top:26rpx;border-top:1rpx solid #e2e8f0;color:#073b61;font-size:30rpx;font-weight:700}.related-item{display:flex;margin-top:22rpx}.related-item image{width:170rpx;height:110rpx;margin-right:18rpx;border-radius:12rpx}.related-item view{display:flex;flex:1;flex-direction:column;justify-content:space-between;font-size:25rpx}.related-date{color:#94a3b8;font-size:21rpx}
.detail-toolbar{position:fixed;z-index:5;right:0;bottom:0;left:0;display:flex;justify-content:space-around;padding:16rpx 12rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(15,52,77,.1)}.detail-toolbar>view,.detail-toolbar button{display:flex;align-items:center;flex-direction:column;justify-content:center;width:23%;margin:0;padding:0;border:0;background:transparent;color:#64748b;font-size:20rpx;line-height:1.5}.detail-toolbar button::after{border:0}.tool-icon{color:#0b6fae;font-size:34rpx;font-weight:700}.heart-active{color:#ef4444}.empty-state{display:flex;align-items:center;flex-direction:column;padding-top:220rpx;color:#64748b}.empty-icon{font-size:80rpx}
.theme-dark{background:#081b2a}.theme-dark .article-card,.theme-dark .detail-toolbar{background:#10283b}.theme-dark .article-title,.theme-dark .article-content,.theme-dark .related-title,.theme-dark .related-item{color:#e0f2fe}.theme-dark .article-summary{background:#17364b;color:#b8d9e9}.theme-dark .related-title{border-color:#28475a}
