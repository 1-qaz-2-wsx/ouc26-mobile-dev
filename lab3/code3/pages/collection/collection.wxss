.collection-page{min-height:100vh;padding:30rpx;background:#f3f7fb}.collection-header{display:flex;flex-direction:column;padding:38rpx;border-radius:22rpx;background:linear-gradient(145deg,#005a9c,#0086b8);color:#fff}.collection-header text:first-child{font-size:40rpx;font-weight:700}.collection-header text:last-child{margin-top:10rpx;color:#d8f3ff;font-size:23rpx}.collection-card{margin-top:24rpx;padding:0 24rpx;border-radius:20rpx;background:#fff}.collection-item{display:flex;padding:25rpx 0;border-bottom:1rpx solid #e2e8f0}.collection-item image{width:190rpx;height:125rpx;margin-right:20rpx;border-radius:12rpx}.collection-item view{display:flex;flex:1;flex-direction:column;justify-content:space-between}.collection-item text:first-child{color:#24384a;font-size:27rpx;font-weight:600}.collection-item text:last-child{color:#94a3b8;font-size:21rpx}.share-button{margin-top:28rpx;border:0;border-radius:999rpx;background:#005a9c;color:#fff}.share-button::after{border:0}.empty{margin-top:24rpx;padding:90rpx;border-radius:20rpx;background:#fff;color:#94a3b8;text-align:center}.theme-dark{background:#081b2a}.theme-dark .collection-card,.theme-dark .empty{background:#10283b}.theme-dark .collection-item text:first-child{color:#e0f2fe}.theme-dark .collection-item{border-color:#28475a}
