.my-page{min-height:100vh;padding-bottom:140rpx;background:#f3f7fb}.profile-panel{display:flex;align-items:center;flex-direction:column;min-height:370rpx;padding:45rpx 30rpx;background:linear-gradient(145deg,#005a9c,#0086b8);color:#fff}.avatar,.avatar-placeholder{display:flex;align-items:center;justify-content:center;width:145rpx;height:145rpx;border:7rpx solid rgba(255,255,255,.85);border-radius:50%;background:#e0f2fe;font-size:70rpx}.nickname{margin-top:18rpx;font-size:34rpx;font-weight:700}.welcome,.login-time{margin-top:8rpx;color:#d8f3ff;font-size:21rpx}.login-title{margin-top:18rpx;font-size:25rpx}.login-button,.account-button{margin-top:22rpx;border:0;border-radius:999rpx;background:#fff;color:#005a9c;font-size:25rpx}.login-button::after,.account-button::after{border:0}.stats-row{display:flex;margin:24rpx 28rpx;padding:24rpx;border-radius:20rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(15,52,77,.06)}.stats-row view{display:flex;flex:1;align-items:center;flex-direction:column;border-right:1rpx solid #e2e8f0}.stats-row view:last-child{border:0}.stats-row text:first-child{color:#075985;font-size:34rpx;font-weight:700}.stats-row text:last-child{margin-top:5rpx;color:#8491a5;font-size:21rpx}.favorite-heading{display:flex;align-items:center;justify-content:space-between;padding:20rpx 32rpx}.favorite-title{display:block;color:#073b61;font-size:34rpx;font-weight:700}.favorite-subtitle{display:block;color:#95a3b6;font-size:18rpx;letter-spacing:3rpx}.favorite-heading button{margin:0;padding:0 24rpx;border:0;border-radius:999rpx;background:#e4f3fc;color:#006bb6;font-size:23rpx}.favorite-heading button::after{border:0}.favorite-card{margin:0 28rpx;padding:0 22rpx;border-radius:20rpx;background:#fff}.favorite-item{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #e2e8f0}.favorite-item image{width:170rpx;height:115rpx;margin:0 18rpx;border-radius:12rpx}.favorite-info{display:flex;flex:1;flex-direction:column}.favorite-info text:first-child{color:#24384a;font-size:26rpx;font-weight:600;line-height:1.5}.favorite-info text:last-child{margin-top:12rpx;color:#94a3b8;font-size:20rpx}.quick-heart{padding:18rpx;color:#ef4444;font-size:38rpx}.checkbox{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border:2rpx solid #b8c6d2;border-radius:50%;color:#fff;font-size:22rpx}.checked{border-color:#0086b8;background:#0086b8}.empty-favorites{display:flex;align-items:center;flex-direction:column;margin:0 28rpx;padding:70rpx;background:#fff;border-radius:20rpx;color:#94a3b8}.empty-icon{margin-bottom:16rpx;font-size:72rpx}.batch-bar{position:fixed;z-index:10;right:0;bottom:0;left:0;display:flex;align-items:center;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -7rpx 20rpx rgba(15,52,77,.1)}.batch-bar view{display:flex;align-items:center;margin-right:auto}.batch-bar view text:last-child{margin-left:10rpx}.batch-bar button{margin:0 0 0 14rpx;padding:0 22rpx;border:0;border-radius:999rpx;background:#eaf5fc;color:#075985;font-size:22rpx}.batch-bar button:last-child{background:#005a9c;color:#fff}.batch-bar button::after{border:0}
.theme-dark{background:#081b2a}.theme-dark .stats-row,.theme-dark .favorite-card,.theme-dark .empty-favorites,.theme-dark .batch-bar,.theme-dark .profile-dialog{background:#10283b}.theme-dark .favorite-title,.theme-dark .favorite-info text:first-child,.theme-dark .dialog-title{color:#e0f2fe}.theme-dark .stats-row view,.theme-dark .favorite-item{border-color:#28475a}
.account-panel{margin:24rpx 28rpx;padding:28rpx;border-radius:20rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(15,52,77,.06)}.account-panel-title{display:block;color:#073b61;font-size:30rpx;font-weight:700}.account-panel-tip{display:block;margin-top:6rpx;color:#94a3b8;font-size:21rpx}.account-actions{display:flex;margin-top:24rpx}.account-actions button{flex:1;margin:0 6rpx;padding:0;border:0;border-radius:14rpx;background:#e4f3fc;color:#006bb6;font-size:23rpx}.account-actions button::after,.nickname-editor button::after{border:0}.account-actions .logout-button{background:#fff1f2;color:#d9485f}.nickname-editor{margin-top:22rpx}.nickname-editor input{height:78rpx;padding:0 22rpx;border:1rpx solid #dbe5ec;border-radius:14rpx;background:#f8fafc;font-size:26rpx}.nickname-editor view{display:flex;justify-content:flex-end;margin-top:18rpx}.nickname-editor button{margin:0 0 0 14rpx;border:0;border-radius:14rpx;background:#edf3f7;color:#64748b;font-size:23rpx}.nickname-editor button:last-child{background:#005a9c;color:#fff}.theme-dark .account-panel{background:#10283b}.theme-dark .account-panel-title{color:#e0f2fe}.theme-dark .nickname-editor input{border-color:#315064;background:#17364b;color:#e0f2fe}
