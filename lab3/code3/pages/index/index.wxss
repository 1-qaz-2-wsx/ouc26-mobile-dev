.page { min-height: 100vh; background: #f3f7fb; padding-bottom: 24rpx; }
.page-header { display:flex; flex-direction:column; padding:38rpx 32rpx 86rpx; background:linear-gradient(145deg,#005a9c,#0086b8); color:#fff; }
.eyebrow{color:#a5e7ff;font-size:19rpx;font-weight:700;letter-spacing:5rpx}.page-title{margin-top:12rpx;font-size:42rpx;font-weight:700}.page-desc{margin-top:10rpx;color:#d8f3ff;font-size:24rpx}
.swiper-card{overflow:hidden;margin:-52rpx 28rpx 0;border:6rpx solid #fff;border-radius:22rpx;box-shadow:0 14rpx 35rpx rgba(0,62,104,.2)}swiper{height:350rpx}swiper-item{position:relative}swiper image{width:100%;height:100%}.swiper-mask{position:absolute;right:0;bottom:0;left:0;height:130rpx;background:linear-gradient(transparent,rgba(0,31,55,.75))}.swiper-title{position:absolute;left:28rpx;bottom:35rpx;color:#fff;font-size:28rpx;font-weight:600}
.search-box{display:flex;align-items:center;margin:28rpx 28rpx 18rpx;padding:0 24rpx;height:78rpx;border-radius:18rpx;background:#fff;color:#789;box-shadow:0 6rpx 18rpx rgba(15,52,77,.06)}.search-box input{flex:1;margin:0 16rpx;font-size:26rpx}.category-scroll{white-space:nowrap}.category-row{display:flex;padding:0 28rpx 8rpx}.category{margin-right:16rpx;padding:12rpx 24rpx;border-radius:999rpx;background:#e8eef4;color:#567;font-size:23rpx}.category-active{background:#005a9c;color:#fff}
.section-heading{display:flex;justify-content:space-between;padding:28rpx 32rpx 18rpx;color:#8491a5;font-size:22rpx}.section-title{color:#073b61;font-size:34rpx;font-weight:700}.list-card{margin:0 28rpx;padding:0 22rpx;border-radius:20rpx;background:#fff}.news-item{position:relative;padding-right:62rpx}.news-read{opacity:.62}.item-actions{display:flex;position:absolute;right:0;top:20rpx;bottom:20rpx;flex-direction:column;align-items:center;justify-content:space-between}.heart{color:#91a0af;font-size:40rpx}.heart-active{color:#ef4444}.more{color:#60758a;font-size:32rpx;font-weight:700}.empty{display:flex;align-items:center;flex-direction:column;margin:20rpx 28rpx;padding:80rpx;background:#fff;border-radius:20rpx;color:#94a3b8}.empty-icon{font-size:70rpx;margin-bottom:20rpx}
.mask{position:fixed;z-index:20;inset:0;background:rgba(0,0,0,.42)}.action-sheet{position:fixed;z-index:21;right:0;bottom:-700rpx;left:0;padding:28rpx 28rpx 40rpx;border-radius:28rpx 28rpx 0 0;background:#fff;transition:bottom .25s}.action-show{bottom:0}.action-title{display:block;margin-bottom:18rpx;color:#334155;font-size:26rpx;font-weight:600}.action-sheet button{margin-top:12rpx;border:0;border-radius:16rpx;background:#f0f6fa;color:#075985;font-size:27rpx}.action-sheet button::after{border:0}
.theme-dark{background:#081b2a;color:#d7e8f2}.theme-dark .search-box,.theme-dark .list-card,.theme-dark .empty,.theme-dark .action-sheet{background:#10283b}.theme-dark .section-title,.theme-dark .news-title,.theme-dark .action-title{color:#e0f2fe}.theme-dark .category{background:#17364b;color:#b8d0df}.theme-dark .category-active{background:#0284c7;color:#fff}.theme-dark .action-sheet button{background:#17364b;color:#bae6fd}
