<view class="settings-page {{isDark ? 'theme-dark' : ''}}">
  <view class="settings-section"><text class="section-label">外观</text><view class="setting-row"><text>主题</text><view class="choices"><text data-value="system" bindtap="chooseTheme" class="{{settings.theme === 'system' ? 'active' : ''}}">跟随系统</text><text data-value="light" bindtap="chooseTheme" class="{{settings.theme === 'light' ? 'active' : ''}}">浅色</text><text data-value="dark" bindtap="chooseTheme" class="{{settings.theme === 'dark' ? 'active' : ''}}">深色</text></view></view><view class="setting-row"><text>正文大小</text><view class="choices"><text data-value="small" bindtap="chooseFont" class="{{settings.fontSize === 'small' ? 'active' : ''}}">小</text><text data-value="medium" bindtap="chooseFont" class="{{settings.fontSize === 'medium' ? 'active' : ''}}">中</text><text data-value="large" bindtap="chooseFont" class="{{settings.fontSize === 'large' ? 'active' : ''}}">大</text></view></view></view>
  <view class="settings-section"><text class="section-label">数据管理</text><view class="action-row" bindtap="clearHistory"><text>清除阅读历史</text><text>›</text></view><view class="action-row danger" bindtap="clearFavorites"><text>清除全部收藏</text><text>›</text></view><view class="action-row"><text>本地存储占用</text><text>{{storageSize}} KB</text></view></view>
  <view class="settings-section"><text class="section-label">关于</text><view class="action-row"><text>应用</text><text>海大新闻网</text></view><view class="action-row"><text>版本</text><text>{{version}}</text></view><view class="about">新闻内容为课程实验使用的本地模拟数据，页面不上传头像、昵称、收藏或阅读记录。</view></view>
</view>
