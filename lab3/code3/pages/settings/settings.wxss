.settings-page{min-height:100vh;padding:26rpx;background:#f3f7fb}.settings-section{margin-bottom:25rpx;padding:22rpx 26rpx;border-radius:20rpx;background:#fff}.section-label{display:block;margin-bottom:15rpx;color:#8091a3;font-size:21rpx}.setting-row,.action-row{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;border-bottom:1rpx solid #e8edf2;color:#334155;font-size:27rpx}.setting-row:last-child,.action-row:last-child{border:0}.choices{display:flex}.choices text{margin-left:10rpx;padding:10rpx 16rpx;border-radius:999rpx;background:#edf2f6;color:#64748b;font-size:21rpx}.choices .active{background:#005a9c;color:#fff}.action-row text:last-child{color:#94a3b8}.danger text:first-child{color:#dc4458}.about{padding:22rpx 0 8rpx;color:#94a3b8;font-size:22rpx;line-height:1.7}.theme-dark{background:#081b2a}.theme-dark .settings-section{background:#10283b}.theme-dark .setting-row,.theme-dark .action-row{border-color:#28475a;color:#e0f2fe}.theme-dark .choices text{background:#17364b}.theme-dark .choices .active{background:#0284c7}.theme-dark .danger text:first-child{color:#fb7185}
