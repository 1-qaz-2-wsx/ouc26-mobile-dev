.history-page{min-height:100vh;padding:30rpx;background:#f3f7fb}.history-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.history-heading>text{color:#073b61;font-size:36rpx;font-weight:700}.history-heading button{margin:0;border:0;background:transparent;color:#ef4444;font-size:24rpx}.history-heading button::after{border:0}.history-card,.empty{padding:0 24rpx;border-radius:20rpx;background:#fff}.history-item{display:flex;padding:24rpx 0;border-bottom:1rpx solid #e2e8f0}.history-item image{width:180rpx;height:120rpx;margin-right:20rpx;border-radius:12rpx}.history-item view{display:flex;flex:1;flex-direction:column;justify-content:space-between}.history-item text:first-child{color:#24384a;font-size:27rpx;font-weight:600}.history-item text:last-child{color:#94a3b8;font-size:20rpx}.empty{padding:100rpx;color:#94a3b8;text-align:center}.theme-dark{background:#081b2a}.theme-dark .history-card,.theme-dark .empty{background:#10283b}.theme-dark .history-heading>text,.theme-dark .history-item text:first-child{color:#e0f2fe}.theme-dark .history-item{border-color:#28475a}
