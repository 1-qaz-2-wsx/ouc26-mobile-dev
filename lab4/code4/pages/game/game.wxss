.game-page{min-height:100vh;padding:34rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:linear-gradient(180deg,#dff4f8,#edf6fa 430rpx)}
.game-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:24rpx}.game-head view:first-child text{display:block}.eyebrow{color:#176b7a;font-size:18rpx;font-weight:700;letter-spacing:3rpx}.game-title{margin-top:5rpx;color:#17324d;font-size:40rpx;font-weight:800}.move-card{display:flex;align-items:center;flex-direction:column;padding:12rpx 20rpx;border-radius:18rpx;background:#17324d;color:#fff;box-shadow:0 8rpx 20rpx rgba(23,50,77,.18)}.move-card text:first-child{font-size:38rpx;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.move-card text:last-child{margin-top:5rpx;color:#d8f4f5;font-size:17rpx}
.board-card{padding:22rpx;border:1rpx solid rgba(23,50,77,.08);border-radius:28rpx;background:#fff;box-shadow:0 16rpx 40rpx rgba(23,50,77,.1)}.board-top{display:flex;justify-content:space-between;margin-bottom:16rpx;color:#526f7b;font-size:19rpx}.board-top text:first-child{color:#17324d;font-weight:600}.canvas-shell{overflow:hidden;margin:0 auto;border:8rpx solid #17324d;border-radius:18rpx;background:#cfe8ec;box-shadow:inset 0 0 0 2rpx rgba(255,255,255,.3)}.game-canvas{display:block;touch-action:none}.legend{display:flex;justify-content:center;margin-top:18rpx;color:#526f7b;font-size:18rpx}.legend>view{display:flex;align-items:center;margin:0 15rpx}.dot{display:inline-block;width:14rpx;height:14rpx;margin-right:8rpx;border-radius:50%}.target{background:#d99618}.box{background:#8d522b}.player{background:#c83737}
.status-banner{min-height:44rpx;margin:18rpx auto 0;padding:12rpx 22rpx;box-sizing:border-box;border:1rpx solid #c8dfe4;border-radius:16rpx;background:#f9fdfd;color:#31586c;font-size:21rpx;line-height:1.45;text-align:center}.status-banner.warning{border-color:#e1b647;background:#fff7dd;color:#704b00}.status-banner.error{border-color:#d97878;background:#fff0f0;color:#8a2525}.status-banner.success{border-color:#63a77b;background:#eaf8ef;color:#22623a}.status-banner.hint{border-color:#69aab3;background:#e8f7f8;color:#175d67}
.controller{width:100%;margin:20rpx auto 28rpx}.controller-row{display:flex;width:100%;align-items:center;justify-content:center}.controller-top{margin-bottom:18rpx}.controller-bottom .direction+.direction{margin-left:18rpx}.direction{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;min-width:96rpx;min-height:96rpx;margin:0;padding:0;border:0;border-radius:18rpx;background:linear-gradient(145deg,#244765,#17324d);color:#fff;font-size:38rpx;font-weight:700;line-height:96rpx;box-shadow:0 8rpx 0 #0e2235,0 12rpx 20rpx rgba(23,50,77,.2);transition:opacity .1s ease,background .1s ease,box-shadow .1s ease}.direction::after{border:0}.key-active{opacity:.72}.direction.hint-key{background:#8a5a00;box-shadow:0 0 0 6rpx #ffe39a,0 8rpx 0 #5d3d00,0 12rpx 20rpx rgba(138,90,0,.24)}.direction.invalid-key{background:#a93434;box-shadow:0 8rpx 0 #6f2020,0 12rpx 20rpx rgba(139,37,37,.2)}
.game-actions{width:620rpx;max-width:100%;margin:0 auto;box-sizing:border-box}.action-row{display:flex;width:100%;align-items:center;justify-content:center}.action-row+.action-row{margin-top:14rpx}.action-row button+button{margin-left:14rpx}.game-actions button{flex:1;width:0;min-width:0;min-height:96rpx;margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;padding:0 12rpx;border:1rpx solid #b8d4da;border-radius:16rpx;background:#fff;color:#274f62;font-size:22rpx;line-height:96rpx;box-sizing:border-box}.game-actions button::after{border:0}.action-row:first-child button:first-child{border-color:#8ec5cc;background:#dff4f6;color:#175d67}.game-actions button[disabled]{border-color:#dbe5e8;background:#eef3f4;color:#82959d;opacity:.72}
.setting-row{display:flex;width:620rpx;max-width:100%;align-items:center;justify-content:space-between;margin:18rpx auto 0;padding:12rpx 20rpx;box-sizing:border-box;border-radius:16rpx;background:rgba(255,255,255,.75);color:#31586c;font-size:22rpx}.setting-row switch{transform:scale(.82)}
@media (max-width:360px){.game-page{padding-right:20rpx;padding-left:20rpx}.board-card{padding:16rpx}.game-title{font-size:36rpx}.controller{margin-top:16rpx}.controller-bottom .direction+.direction{margin-left:14rpx}}
