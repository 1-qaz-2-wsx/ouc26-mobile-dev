.home-page{min-height:100vh;background:linear-gradient(180deg,#dff4f8 0,#edf6fa 440rpx,#edf6fa 100%)}
.hero{position:relative;overflow:hidden;padding:54rpx 38rpx 100rpx;background:linear-gradient(145deg,#17324d,#176b7a);color:#fff}.hero::before,.hero::after{position:absolute;border-radius:50%;background:rgba(142,231,236,.12);content:""}.hero::before{top:-110rpx;right:-60rpx;width:330rpx;height:330rpx}.hero::after{right:190rpx;bottom:-180rpx;width:280rpx;height:280rpx}
.hero-kicker,.hero-title,.hero-desc{position:relative;z-index:1;display:block}.hero-kicker{color:#8ee7ec;font-size:20rpx;font-weight:700;letter-spacing:5rpx}.hero-title{margin-top:18rpx;font-size:58rpx;font-weight:800;letter-spacing:4rpx}.hero-desc{max-width:390rpx;margin-top:12rpx;color:#d8f4f5;font-size:25rpx;line-height:1.45}
.progress-card{position:absolute;z-index:2;right:34rpx;bottom:30rpx;display:flex;align-items:flex-end;flex-direction:column;padding:16rpx 22rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:18rpx;background:rgba(255,255,255,.14)}.progress-card view{font-size:22rpx}.progress-card>text{margin-top:4rpx;color:#d8f4f5;font-size:19rpx}.progress-number{margin-right:5rpx;font-size:38rpx;font-weight:800}
.content{position:relative;z-index:3;margin-top:-46rpx;padding:0 28rpx 60rpx}.mode-card{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx;padding:22rpx 24rpx;border:1rpx solid #cae0e4;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(23,50,77,.08)}.mode-card>view{display:flex;min-width:0;flex:1;flex-direction:column}.mode-title{font-size:27rpx;font-weight:800}.mode-desc{margin-top:5rpx;color:#526f7b;font-size:20rpx;line-height:1.45}.mode-card switch{margin-left:20rpx;transform:scale(.82)}
.section-title{display:flex;align-items:flex-end;justify-content:space-between;padding:0 8rpx 22rpx}.section-title view text{display:block}.section-title view text:first-child{color:#17324d;font-size:34rpx;font-weight:800}.section-title view text:last-child{margin-top:3rpx;color:#607d89;font-size:17rpx;letter-spacing:4rpx}.section-title>text{color:#176b7a;font-size:21rpx}
.level-group{margin-bottom:32rpx}.group-head{display:flex;align-items:center;margin:0 6rpx 18rpx}.group-order{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;margin-right:16rpx;border-radius:16rpx;background:#17324d;color:#fff;font-size:21rpx;font-weight:800}.group-head>view:last-child{display:flex;flex-direction:column}.group-name{font-size:28rpx;font-weight:800}.group-desc{margin-top:3rpx;color:#526f7b;font-size:19rpx}
.level-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.level-card{width:calc(50% - 10rpx);overflow:hidden;margin-bottom:20rpx;box-sizing:border-box;border:1rpx solid rgba(23,50,77,.08);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(23,50,77,.08);transition:transform .12s ease,box-shadow .12s ease}.card-active{transform:scale(.98);box-shadow:0 6rpx 18rpx rgba(23,50,77,.12)}.level-card.locked{box-shadow:none}.preview-wrap{position:relative;height:240rpx;padding:15rpx;box-sizing:border-box;background:linear-gradient(145deg,#d7eef2,#edf7f8)}.preview-wrap image{width:100%;height:100%;border-radius:15rpx}.level-number{position:absolute;z-index:2;top:25rpx;left:25rpx;padding:7rpx 13rpx;border-radius:10rpx;background:#17324d;color:#fff;font-size:20rpx;font-weight:800}.complete-badge{position:absolute;z-index:2;right:24rpx;bottom:24rpx;padding:7rpx 12rpx;border-radius:999rpx;background:#ffe39a;color:#694500;font-size:18rpx;font-weight:700}.lock-overlay{position:absolute;z-index:1;top:15rpx;right:15rpx;bottom:15rpx;left:15rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;border-radius:15rpx;background:rgba(14,34,53,.82);color:#fff}.lock-overlay text:first-child{font-size:22rpx;font-weight:800;letter-spacing:3rpx}.lock-overlay text:last-child{margin-top:7rpx;color:#d8f4f5;font-size:18rpx}
.level-info{padding:20rpx}.level-info>view{display:flex;align-items:center;justify-content:space-between}.level-info>view text:first-child{font-size:27rpx;font-weight:700}.level-info>view text:last-child{padding:4rpx 10rpx;border-radius:999rpx;background:#e7f6f7;color:#176b7a;font-size:17rpx}.star-text{display:block;margin-top:10rpx;color:#8a5a00;font-size:22rpx;letter-spacing:2rpx}.locked .star-text{color:#657f8a;letter-spacing:0}.best-text{display:block;margin-top:5rpx;color:#526f7b;font-size:19rpx;line-height:1.45}
.rules-card{display:flex;padding:25rpx;border:1rpx solid #d7e8eb;border-radius:22rpx;background:#f9fdfd}.rules-icon{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin-right:20rpx;border-radius:18rpx;background:#dff3f5;color:#176b7a;font-size:19rpx;font-weight:800;letter-spacing:1rpx}.rules-card>view:last-child{display:flex;min-width:0;flex:1;flex-direction:column}.rules-title{font-size:25rpx;font-weight:700}.rules-text{margin-top:5rpx;color:#526f7b;font-size:21rpx;line-height:1.6}
@media (max-width:360px){.hero-desc{max-width:340rpx}.preview-wrap{height:210rpx}.section-title>text{max-width:170rpx;text-align:right}.level-info{padding:16rpx}.level-info>view text:first-child{font-size:24rpx}}
