page {
  min-height: 100%;
  color: #24302b;
  background: #f5f1e8;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, image, scroll-view, map { box-sizing: border-box; }
.page-shell { min-height: 100vh; padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.section { margin-top: 28rpx; }
.section-title { margin-bottom: 16rpx; color: #223d33; font-size: 34rpx; font-weight: 700; }
.section-subtitle { margin-top: -6rpx; color: #7a7f78; font-size: 24rpx; line-height: 1.6; }
.card { padding: 24rpx; border: 1rpx solid rgba(47, 102, 84, 0.1); border-radius: 24rpx; background: #fffdf8; box-shadow: 0 10rpx 28rpx rgba(48, 58, 52, 0.06); }
.empty-card { padding: 36rpx 24rpx; border: 2rpx dashed #c8c7bd; border-radius: 20rpx; color: #777c76; background: rgba(255, 253, 248, 0.68); text-align: center; line-height: 1.7; }
.tag { display: inline-flex; margin: 0 10rpx 10rpx 0; padding: 8rpx 14rpx; border-radius: 999rpx; color: #315f50; background: #e5eee8; font-size: 22rpx; }
.muted { color: #7a7f78; }
.link-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #ece9df; }
.link-row:last-child { border-bottom: 0; }
.primary-button { color: #fff; background: #2f6654; border-radius: 999rpx; font-size: 28rpx; }
.primary-button::after, .ghost-button::after { border: 0; }
.ghost-button { color: #2f6654; background: #e7efe9; border-radius: 999rpx; font-size: 26rpx; }
.status-note { margin-top: 16rpx; padding: 18rpx 20rpx; border-left: 6rpx solid #c58b4e; border-radius: 12rpx; color: #69543d; background: #f6eadb; font-size: 24rpx; line-height: 1.65; }
