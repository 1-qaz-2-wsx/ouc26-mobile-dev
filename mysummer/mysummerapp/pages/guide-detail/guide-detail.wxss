page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; overflow: hidden; }
.article-head { padding: 36rpx 30rpx; border-radius: 28rpx; background: #ddd1bc; }
.article-title, .article-summary, .article-meta, .toc-title, .toc-item, .article-index, .article-heading, .article-body { display: block; }
.article-title { margin-top: 18rpx; color: #2b453a; font-size: 48rpx; font-weight: 800; }
.article-summary { margin-top: 18rpx; color: #636b64; font-size: 26rpx; line-height: 1.65; }
.article-meta { margin-top: 22rpx; color: #81847e; font-size: 22rpx; }
.toc-title { margin-bottom: 14rpx; font-weight: 700; }
.toc-item { padding: 8rpx 0; color: #577064; font-size: 24rpx; }
.article-section { margin-top: 44rpx; }
.article-index { color: #b55f48; font-size: 22rpx; font-weight: 700; }
.article-heading { margin-top: 8rpx; font-size: 36rpx; font-weight: 800; }
.article-body { margin-top: 18rpx; color: #505852; font-size: 28rpx; line-height: 1.85; }
.tool-button { margin-top: 40rpx; }
