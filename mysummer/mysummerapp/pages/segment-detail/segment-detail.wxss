page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; overflow: hidden; }
.route-hero { padding: 40rpx 30rpx; border-radius: 28rpx; color: #fff; background: #a95843; }
.route-kicker, .route-title, .summary-value, .summary-label { display: block; }
.route-kicker { opacity: .7; font-size: 20rpx; letter-spacing: 3rpx; }
.route-title { margin-top: 20rpx; font-size: 44rpx; font-weight: 800; }
.route-badges { margin-top: 24rpx; }
.route-badge { display: inline-flex; margin-right: 10rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: #7a3828; background: #f4d8ca; font-size: 22rpx; }
.route-badge.warn { color: #6c512a; background: #f4e7b8; }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 16rpx; }
.summary-item { padding: 20rpx 8rpx; border-radius: 18rpx; background: #fffdf8; text-align: center; }
.summary-value { color: #284d3f; font-size: 25rpx; font-weight: 700; }
.summary-label { margin-top: 7rpx; color: #878a84; font-size: 20rpx; }
.photo-placeholder { display: flex; align-items: center; justify-content: center; height: 260rpx; border-radius: 22rpx 22rpx 0 0; color: #71776f; background: #d8d9cd; }
.description { border-radius: 0 0 22rpx 22rpx; box-shadow: none; line-height: 1.7; }
.tip-row { display: flex; gap: 12rpx; padding: 10rpx 0; line-height: 1.6; }
