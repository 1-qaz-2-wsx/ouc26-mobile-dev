page { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; overflow: hidden; }
.tool-hero { padding: 40rpx 32rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(140deg, #a75843, #d09565); }
.tool-kicker, .tool-title, .tool-copy, .option-name, .option-note, .result-label, .result-total, .result-route { display: block; }
.tool-kicker { opacity: .7; font-size: 20rpx; letter-spacing: 4rpx; }
.tool-title { margin-top: 26rpx; font-size: 40rpx; font-weight: 700; }
.tool-copy { margin-top: 12rpx; opacity: .82; font-size: 23rpx; }
.option-grid { display: grid; gap: 14rpx; }
.option { padding: 22rpx; border: 2rpx solid transparent; border-radius: 20rpx; background: #fffdf8; }
.option.active, .choice-chip.active { border-color: #2f6654; color: #204c3d; background: #e2ece5; }
.option-name { font-size: 28rpx; font-weight: 700; }
.option-note { margin-top: 8rpx; color: #777c76; font-size: 22rpx; }
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.choice-chip { padding: 16rpx 20rpx; border: 2rpx solid transparent; border-radius: 999rpx; background: #fffdf8; font-size: 24rpx; }
.result-card { text-align: center; }
.result-label { color: #777c76; font-size: 24rpx; }
.result-total { margin-top: 4rpx; color: #a34f3b; font-size: 70rpx; font-weight: 800; }
.result-route { color: #6f746f; font-size: 23rpx; }
.cost-list { margin: 26rpx 0 18rpx; padding-top: 14rpx; border-top: 1rpx solid #ebe7dc; }
.cost-row, .emergency, .recommended { display: flex; justify-content: space-between; padding: 12rpx 4rpx; }
.cost-row { color: #626862; }
.emergency { margin-top: 10rpx; color: #8b5b32; background: #f7ead9; border-radius: 12rpx; padding: 16rpx; }
.recommended { margin: 14rpx 0 20rpx; font-size: 29rpx; font-weight: 700; }
