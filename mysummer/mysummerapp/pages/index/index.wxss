page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea { flex: 1; overflow: hidden; }
.map-page { padding-top: 18rpx; }
.hero { min-height: 280rpx; padding: 46rpx 34rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(145deg, #244d40, #6b8770 64%, #bd7759); }
.hero-kicker, .hero-title, .hero-copy { display: block; }
.hero-kicker { opacity: .72; font-size: 20rpx; letter-spacing: 4rpx; }
.hero-title { margin-top: 44rpx; font-size: 50rpx; font-weight: 700; }
.hero-copy { margin-top: 16rpx; opacity: .88; font-size: 26rpx; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 18rpx; }
.stat { padding: 20rpx 8rpx; border-radius: 18rpx; background: #fffdf8; text-align: center; }
.stat-value, .stat-label { display: block; }
.stat-value { color: #244d40; font-size: 27rpx; font-weight: 700; }
.stat-label { margin-top: 8rpx; color: #888b84; font-size: 20rpx; }
.route-map { width: 100%; height: 650rpx; margin-top: 18rpx; border-radius: 24rpx; overflow: hidden; }
.place-preview { position: relative; z-index: 2; margin: -44rpx 20rpx 0; }
.preview-top { display: flex; justify-content: space-between; }
.preview-day, .preview-name, .preview-copy { display: block; }
.preview-day { color: #b25a45; font-size: 22rpx; font-weight: 700; }
.preview-name { margin-top: 6rpx; font-size: 38rpx; font-weight: 700; }
.preview-copy { margin: 14rpx 0; color: #666c67; line-height: 1.6; }
.preview-close { padding: 0 8rpx; color: #8b8e88; font-size: 48rpx; }
.retry-button { width: 260rpx; margin-top: 20rpx; }
